# Copy to .env and fill in LOCALLY. Never commit .env.

# Application account: created by scripts/init_db.py with SELECT-only privileges
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=safesql_app
MYSQL_PASSWORD=choose_a_new_password_for_the_app_account
MYSQL_DATABASE=safesql

# Administrator account: used ONLY by `python -m scripts.init_db`.
# Leave MYSQL_ADMIN_PASSWORD unset to be prompted (hidden) instead of storing it on disk.
MYSQL_ADMIN_USER=your_mysql_admin_username
# MYSQL_ADMIN_PASSWORD=

# LLM: auto | ollama | demo
LLM_MODE=auto
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:3b

# Guardrails
MAX_ROWS=100
QUERY_TIMEOUT_SECONDS=5
